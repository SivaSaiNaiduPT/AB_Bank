            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import java.time.LocalDate

// Example: start date = today minus 6 months
def startDate = LocalDate.now().minusMonths(6)
def endDate = LocalDate.now()

// If application expects 0-based month
def zeroBased = true

def bmon = zeroBased ? startDate.getMonthValue() - 1 : startDate.getMonthValue()
def emon = zeroBased ? endDate.getMonthValue() - 1 : endDate.getMonthValue()

vars.put(&quot;bday&quot;, startDate.getDayOfMonth().toString())
vars.put(&quot;bmon&quot;, bmon.toString())
vars.put(&quot;byear&quot;, startDate.getYear().toString())

vars.put(&quot;eday&quot;, endDate.getDayOfMonth().toString())
vars.put(&quot;emon&quot;, emon.toString())
vars.put(&quot;eyear&quot;, endDate.getYear().toString())</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="TestPlan.comments">//for end date use current date with --time and previous dates use timeshift functiom</stringProp>
            </JSR223PreProcessor>
